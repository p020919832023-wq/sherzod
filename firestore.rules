rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'level', 'xp', 'coins'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64
        && data.level is number && data.level >= 1 && data.level <= 100
        && data.xp is number && data.xp >= 0
        && data.coins is number && data.coins >= 0
        && (!('crystals' in data) || (data.crystals is number && data.crystals >= 0))
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 64))
        && (!('equippedPet' in data) || (data.equippedPet is string && data.equippedPet.size() <= 64))
        && (!('unlockedAvatars' in data) || (data.unlockedAvatars is list && data.unlockedAvatars.size() <= 50))
        && (!('unlockedPets' in data) || (data.unlockedPets is list && data.unlockedPets.size() <= 50))
        && (!('unlockedGear' in data) || (data.unlockedGear is list && data.unlockedGear.size() <= 50))
        && (!('achievements' in data) || (data.achievements is list && data.achievements.size() <= 100));
    }

    function isValidGameScore(data) {
      return data.keys().hasAll(['userId', 'playerName', 'gameMode', 'score'])
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.playerName is string && data.playerName.size() > 0 && data.playerName.size() <= 64
        && data.gameMode is string && data.gameMode.size() > 0 && data.gameMode.size() <= 32
        && data.score is number && data.score >= 0 && data.score <= 10000000
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 64));
    }

    // User Profile: private to the owner
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid;
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid;
      allow delete: if false;
    }

    // Leaderboard Scores: public read, authenticated owner create
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(scoreId)
        && isValidGameScore(incoming())
        && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
